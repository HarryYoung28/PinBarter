generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  role          String         @default("user")
  createdAt     DateTime       @default(now())
  collection    Collection[]
  wishlist      Wishlist[]
  tradeListings TradeListing[]
  tradesAsOfferer  Trade[]     @relation("Offerer")
  tradesAsReceiver Trade[]     @relation("Receiver")
}

model Pin {
  id            String         @id @default(cuid())
  name          String         @unique
  series        String?
  description   String?
  imageUrl      String?
  isApproved    Boolean        @default(false)
  rarity        String         @default("Standard")
  editionSize   Int?
  credits       Int            @default(1)
  createdAt     DateTime       @default(now())
  collection    Collection[]
  wishlist      Wishlist[]
  tradeItems    TradeItem[]
  tradeListings TradeListing[]
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  pinId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  pin       Pin      @relation(fields: [pinId], references: [id])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  pinId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  pin       Pin      @relation(fields: [pinId], references: [id])
}

model TradeListing {
  id               String   @id @default(cuid())
  userId           String
  pinId            String
  wantsDescription String
  creditFlexibility Int     @default(0)
  status           String   @default("open")
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
  pin              Pin      @relation(fields: [pinId], references: [id])
  trades           Trade[]
}

model Trade {
  id                String       @id @default(cuid())
  listingId         String
  offererId         String
  receiverId        String
  status            String       @default("pending")
  offererConfirmed  Boolean      @default(false)
  receiverConfirmed Boolean      @default(false)
  createdAt         DateTime     @default(now())
  listing           TradeListing @relation(fields: [listingId], references: [id])
  offerer           User         @relation("Offerer", fields: [offererId], references: [id])
  receiver          User         @relation("Receiver", fields: [receiverId], references: [id])
  items             TradeItem[]
}

model TradeItem {
  id        String @id @default(cuid())
  tradeId   String
  pinId     String
  direction String
  trade     Trade  @relation(fields: [tradeId], references: [id])
  pin       Pin    @relation(fields: [pinId], references: [id])
}